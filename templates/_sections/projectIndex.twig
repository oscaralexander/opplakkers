{% import '_macros/ui' as ui %}

{#
  Hand-picked projects, or — when none are chosen — every project in the
  chosen category, or every project when no category is chosen either.
#}
{% set projects = section.projects.with(['image']).all() %}
{% if projects is empty %}
    {% set query = craft.entries().section('projects').with(['image']) %}
    {% if section.projectCategory.value ?? false %}
        {% do query.projectCategory(section.projectCategory.value) %}
    {% endif %}
    {% set projects = query.all() %}
{% endif %}
{% set alignment = section.sectionHeaderAlignment ?? 'left' %}
{% set hasHeader = section.eyebrow or section.title or section.intro|length %}
{% set isBeside = alignment == 'left' and hasHeader %}

{% if projects|length %}
    <section class="{{ ui.sectionClass(section, 'projectIndex') }}">
        <div class="{{ ui.sectionInnerClass(section) }}">
            <div class="grid grid--gap-xxl">
                {% if hasHeader %}
                    <div class="grid__col{{ alignment == 'left' ? ' l:grid__col--span-4' }}">
                        {{ ui.sectionHeader(section, { class: 'section__header--sticky' }) }}
                    </div>
                {% endif %}
                <div class="grid__col{{ isBeside ? ' l:grid__col--span-8' }}">
                    <div class="grid grid--gap-m" data-reveal-group>
                        {% for project in projects %}
                            {% set image = project.image|first %}
                            <div class="grid__col s:grid__col--span-6 {{ isBeside ? 'l:grid__col--span-6' : 'l:grid__col--span-3' }} js-reveal">
                                <article class="project u-theme-contrast">
                                    {% if image %}
                                        {{ ui.image(image, {
                                            class: 'project__image',
                                            ratio: 1,
                                            sizes: isBeside ? '(min-width: 1280px) 30vw, (min-width: 768px) 46vw, calc(93vw - 8px)' : '(min-width: 1280px) 21vw, (min-width: 768px) 46vw, calc(93vw - 8px)',
                                            widths: [320, 480, 640, 800, 960, 1200],
                                        }) }}
                                    {% endif %}
                                    {% if project.projectCategory.value ?? false %}
                                        <span class="project__category">{{ project.projectCategory.label }}</span>
                                    {% endif %}
                                    <h3 class="project__title">
                                        {{ project.title }}
                                        {{ ui.icon('arrow-right') }}
                                    </h3>
                                    {% if project.location %}
                                        <span class="project__location">{{ project.location }}</span>
                                    {% endif %}
                                    <a class="project__link" href="{{ project.url }}" aria-label="{{ project.title }}"></a>
                                </article>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}
