{% import '_macros/ui' as ui %}

{% set alignment = section.sectionHeaderAlignment ?? 'left' %}

<section class="{{ ui.sectionClass(section, 'text') }}">
    <div class="{{ ui.sectionInnerClass(section) }}">
        <div class="grid grid--center grid--gap-xxl">
            <div class="grid__col l:grid__col--span-{{ alignment == 'left' ? '5' : '8' }}">
                {{ ui.sectionHeader(section) }}
            </div>
            {% if section.text|length or section.ctas|length %}
                <div class="grid__col l:grid__col--span-{{ alignment == 'left' ? '7' : '8' }}">
                    <div class="stack stack--gap-xl" data-reveal-group>
                        {% if section.text|length %}
                            <div class="text__body richText js-reveal">{{ section.text }}</div>
                        {% endif %}
                        {{ ui.ctas(section.ctas, { align: alignment == 'top' ? 'center' : 'left', class: 'js-reveal' }) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
